  {
    "kpiDefinitionId": 0,
    "pillar": "Business",
    "kpi": "Hotel and car bookings",
    "domain": "shared",
    "stage": "",
    "sourceKey": "kql:kpi:arrivia-demo-bookings-completed",
    "direction": "Decrease",
    "aggregation": "Count",
    "evaluationFrequency": "00:01:00",
    "bucketSize": "00:05:00",
    "lookbackWindow": "1.00:00:00",
    "sampleSize": 0,
    "minObservationsPerBucket": 0,
    "detectionMethod": "BaselinePercent",
    "methodParamsJson": "{\"lookbackDays\":7,\"thresholdPercent\":50}",
    "consecutiveCount": 3,
    "cooldownMinutes": 30,
    "enabled": true,
    "profileKey": "arrivia",
    "grain": "domain",
    "maxEntitiesPerBucket": 100,
    "kqlText": "let bucketSize = {{bucket}};\nlet observed = app('{{SOURCE:sor-frontend}}').customEvents\n| where timestamp >= {{from}} and timestamp < {{to}}\n| where name == \"BookingCompleted\"\n| summarize TotalCount = count() by BucketStart = bin_at(timestamp, bucketSize, datetime(1970-01-01));\n// One row per bucket, 0 when no event arrived, so a total stop is evaluated instead of missing.\nrange BucketStart from bin_at({{from}}, bucketSize, datetime(1970-01-01)) to {{to}} - 1s step bucketSize\n| join kind=leftouter observed on BucketStart\n| project ['kind'] = \"bucket\", BucketStart, TotalCount = coalesce(TotalCount, long(0)), Value = todouble(coalesce(TotalCount, long(0)))",
    "kqlDescription": "Completed hotel and car bookings (BookingCompleted) per bucket - synthetic demo data."
  },
