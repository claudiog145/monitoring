    "kqlText": "let bucketSize = {{bucket}};\nlet observed = app('{{SOURCE:sor-frontend}}').customEvents\n| where timestamp >= {{from}} and timestamp < {{to}}\n| where name == \"BookingCompleted\"\n| summarize TotalCount = count(), Value = sum(todouble(customMeasurements.Amount)) by BucketStart = bin_at(timestamp, bucketSize, datetime(1970-01-01));\n// One row per bucket, 0 when no event arrived, so a total stop is evaluated instead of missing.\nrange BucketStart from bin_at({{from}}, bucketSize, datetime(1970-01-01)) to {{to}} - 1s step bucketSize\n| join kind=leftouter observed on BucketStart\n| project ['kind'] = \"bucket\", BucketStart, TotalCount = coalesce(TotalCount, long(0)), Value = todouble(coalesce(Value, real(0)))",
    "kqlDescription": "Sum of BookingCompleted Amount per bucket - synthetic demo data."
  },
