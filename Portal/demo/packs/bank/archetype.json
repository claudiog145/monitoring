  "scenarios": [
    {
      "key": "core-gw-slow-deploy", "title": "Core-gateway lento tras el despliegue 4.18",
      "description": "Release 4.18 of core-gateway shrinks the CICS/MQ connection pool: every call to the core banking mainframe gets ~5x slower, the balance and transfer screens of web and mobile slow down, and core transfers start timing out.",
      "defaultDurationMinutes": 40,
      "effects": [
        { "kind": "latency-multiplier", "partner": "core-banking", "factor": 5 },
        { "kind": "error-rate", "step": "POST /core/v1/transfers", "rate": 0.25, "exceptionType": "System.TimeoutException" }
      ]
    },
    {
      "key": "mobile-transfer-exceptions", "title": "Tormenta de excepciones en transferencias móviles (release 7.4)",
      "description": "Mobile API release 7.4 maps the favourite beneficiaries payload without a null check: 60 % of the mobile transfers (customers with no favourites) throw NullReferenceException. Web transfers are fine.",
      "defaultDurationMinutes": 20,
      "effects": [
        { "kind": "error-rate", "step": "POST /api/mobile/v2/transfers", "rate": 0.6, "exceptionType": "System.NullReferenceException" }
      ]
    },
    {
      "key": "ach-outage", "title": "Caída de la cámara de compensación ACH",
      "description": "The ACH clearing house (CompensAndes) refuses most credit transfers and answers slowly: interbank transfers are rejected while internal transfers keep working.",
      "defaultDurationMinutes": 30,
      "effects": [
        { "kind": "dependency-failure", "partner": "ach-clearing", "rate": 0.85 },
        { "kind": "latency-multiplier", "partner": "ach-clearing", "factor": 3 }
      ]
    },
    {
      "key": "branch-degraded", "title": "Sucursal B-003 degradada",
      "description": "The regional link of branch B-003 (Arequipa - Yanahuara) saturates: only the customers and operations booked to that branch see slow and failing operations on every channel.",
      "defaultDurationMinutes": 45,
      "effects": [
        { "kind": "entity-only", "entities": ["B-003"] },
        { "kind": "latency-multiplier", "factor": 6 },
        { "kind": "error-rate", "rate": 0.25, "exceptionType": "System.TimeoutException" }
      ]
    },
    {
      "key": "card-network-degraded", "title": "Red de tarjetas degradada",
      "description": "The card network issuer API (Red Cóndor) fails half of the block and status calls: customers cannot lock a lost card from the app.",
      "defaultDurationMinutes": 30,
      "effects": [
        { "kind": "dependency-failure", "partner": "card-network", "rate": 0.5 },
        { "kind": "latency-multiplier", "partner": "card-network", "factor": 4 }
      ]
    },
    {
      "key": "otp-delays", "title": "Demora del proveedor SMS/OTP",
      "description": "The SMS/OTP provider (Mensajería Andes) queues messages: login latency jumps on web and mobile and 70 % of the OTP sends fail, so successful logins drop.",
      "defaultDurationMinutes": 25,
      "effects": [
        { "kind": "latency-multiplier", "partner": "otp-sms", "factor": 8 },
        { "kind": "dependency-failure", "partner": "otp-sms", "rate": 0.7 }
      ]
    },
    {
      "key": "transfers-drop", "title": "Caída silenciosa de transferencias (negocio)",
      "description": "A feature flag hides the 'Transferir' button after a front-end release: transfers fall by ~75 % on mobile and web, with no exception and no latency change. Only the business KPI sees it.",
      "defaultDurationMinutes": 45,
      "effects": [
        { "kind": "traffic-multiplier", "step": "POST /api/mobile/v2/transfers", "factor": 0.2 },
        { "kind": "traffic-multiplier", "step": "POST /banca/transferencias", "factor": 0.3 }
      ]
    },
    {
      "key": "payday-peak", "title": "Pico de quincena / fin de mes (legítimo)",
      "description": "Payday: salaries are credited and customers check balances, pay bills and transfer at once. Traffic grows 50 % on every channel with normal latency and error rate. Nothing is broken: no KPI should alert.",
      "defaultDurationMinutes": 180,
      "effects": [
        { "kind": "traffic-multiplier", "factor": 1.5 }
      ]
    }
  ],
