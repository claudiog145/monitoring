  {
    "kpiDefinitionId": 0,
    "pillar": "Business",
    "kpi": "Transferencias completadas",
    "domain": "banca-movil",
    "stage": "",
    "sourceKey": "kql:kpi:bank-transfers-completed",
    "direction": "Decrease",
    "aggregation": "Value",
    "evaluationFrequency": "00:01:00",
    "bucketSize": "00:05:00",
    "lookbackWindow": "1.00:00:00",
    "sampleSize": 0,
    "minObservationsPerBucket": 60,
    "detectionMethod": "BaselinePercent",
    "methodParamsJson": "{\"lookbackDays\":7,\"thresholdPercent\":50}",
    "consecutiveCount": 2,
    "cooldownMinutes": 30,
    "enabled": true,
    "profileKey": "banco",
    "grain": "domain",
    "maxEntitiesPerBucket": 100,
    "kqlText": "let events = union app('{{SOURCE:bank-web-banking}}').customEvents, app('{{SOURCE:bank-mobile-api}}').customEvents\n| where timestamp >= {{from}} and timestamp < {{to}}\n| summarize Activity = countif(name != \"TransferCompleted\"), Target = countif(name == \"TransferCompleted\") by BucketStart = bin_at(timestamp, {{bucket}}, datetime(1970-01-01));\nrange BucketStart from bin_at({{from}}, {{bucket}}, datetime(1970-01-01)) to {{to}} - 1tick step {{bucket}}\n| join kind=leftouter events on BucketStart\n| project ['kind'] = \"bucket\", BucketStart, TotalCount = tolong(coalesce(Activity, 0)), Value = todouble(coalesce(Target, 0))",
    "kqlDescription": "Banco Andino (demo): TransferCompleted events (web + mobile) per bucket in Value, compared with the same slot of the previous 7 days. TotalCount = the other business events of the two channels (their activity, untouched by a drop of this one), so quiet night buckets are not evaluated while a stop of transfers alone is; empty buckets come back as zero rows."
  },
  {
    "kpiDefinitionId": 0,
    "pillar": "Business",
    "kpi": "Rechazo interbancario (%)",
    "domain": "pagos",
    "stage": "",
    "sourceKey": "kql:kpi:bank-interbank-rejection-rate",
    "direction": "Increase",
    "aggregation": "Value",
    "evaluationFrequency": "00:01:00",
    "bucketSize": "00:05:00",
    "lookbackWindow": "1.00:00:00",
    "sampleSize": 0,
    "minObservationsPerBucket": 5,
    "detectionMethod": "StaticThreshold",
    "methodParamsJson": "{\"threshold\":25}",
    "consecutiveCount": 2,
    "cooldownMinutes": 30,
    "enabled": true,
    "profileKey": "banco",
    "grain": "domain",
    "maxEntitiesPerBucket": 100,
    "kqlText": "let failed = app('{{SOURCE:bank-payments-svc}}').requests\n| where timestamp >= {{from}} and timestamp < {{to}}\n| where name == \"POST /payments/v1/ach/transfers\" and success == false\n| distinct operation_Id;\nlet submitted = app('{{SOURCE:bank-payments-svc}}').customEvents\n| where timestamp >= {{from}} and timestamp < {{to}}\n| where name == \"InterbankTransferSubmitted\"\n| extend Rejected = iff(operation_Id in (failed), 1, 0)\n| summarize Submitted = count(), RejectedCount = sum(Rejected) by BucketStart = bin_at(timestamp, {{bucket}}, datetime(1970-01-01));\nrange BucketStart from bin_at({{from}}, {{bucket}}, datetime(1970-01-01)) to {{to}} - 1tick step {{bucket}}\n| join kind=leftouter submitted on BucketStart\n| extend Submitted = coalesce(Submitted, 0), RejectedCount = coalesce(RejectedCount, 0)\n| project ['kind'] = \"bucket\", BucketStart, TotalCount = tolong(Submitted), Value = iff(Submitted > 0, round(100.0 * todouble(RejectedCount) / todouble(Submitted), 2), real(null))",
    "kqlDescription": "Banco Andino (demo): percentage of InterbankTransferSubmitted events whose ACH request failed (rejected payments) per bucket; TotalCount = submitted transfers, empty buckets come back as zero rows."
  },
  {
    "kpiDefinitionId": 0,
