    "consecutiveCount": 2,
    "cooldownMinutes": 30,
    "enabled": true,
    "profileKey": "banco",
    "grain": "domain",
    "maxEntitiesPerBucket": 100,
    "kqlText": "let events = union app('{{SOURCE:bank-web-banking}}').customEvents, app('{{SOURCE:bank-payments-svc}}').customEvents\n| where timestamp >= {{from}} and timestamp < {{to}}\n| summarize Activity = countif(name != \"BillPaid\"), Target = countif(name == \"BillPaid\") by BucketStart = bin_at(timestamp, {{bucket}}, datetime(1970-01-01));\nrange BucketStart from bin_at({{from}}, {{bucket}}, datetime(1970-01-01)) to {{to}} - 1tick step {{bucket}}\n| join kind=leftouter events on BucketStart\n| project ['kind'] = \"bucket\", BucketStart, TotalCount = tolong(coalesce(Activity, 0)), Value = todouble(coalesce(Target, 0))",
    "kqlDescription": "Banco Andino (demo): BillPaid events (web + payments-svc) per bucket in Value, compared with the same slot of the previous 7 days. TotalCount = the other business events of the two sources (their activity, untouched by a drop of this one), so quiet night buckets are not evaluated while a stop of bill payments alone is; empty buckets come back as zero rows."
  },
