    "profileKey": "kinectify",
    "grain": "domain",
    "maxEntitiesPerBucket": 100,
    "kqlText": "let counts = app('{{SOURCE:aml-alerts-worker}}').customEvents\n| where timestamp >= {{from}} and timestamp < {{to}}\n| where name == \"AlertRaised\"\n| summarize TotalCount = count() by BucketStart = bin_at(timestamp, {{bucket}}, datetime(1970-01-01));\nrange BucketStart from bin_at({{from}}, {{bucket}}, datetime(1970-01-01)) to {{to}} - 1tick step {{bucket}}\n| join kind=leftouter counts on BucketStart\n| project ['kind'] = \"bucket\", BucketStart, TotalCount = tolong(coalesce(TotalCount, 0)), Value = todouble(coalesce(TotalCount, 0))",
    "kqlDescription": "AML alerts raised by the alerts worker per 5-minute bucket (Kinectify demo). A drop means suspicious activity is not reaching analysts. Zero-filled: a bucket without events reads 0."
