  {
    "kpiDefinitionId": 0,
    "pillar": "Business",
    "kpi": "Transactions screened",
    "domain": "screening",
    "stage": "",
    "sourceKey": "kql:kpi:aml-transactions-screened",
    "direction": "Decrease",
    "aggregation": "Count",
    "evaluationFrequency": "00:01:00",
    "bucketSize": "00:05:00",
    "lookbackWindow": "1.00:00:00",
    "sampleSize": 0,
    "minObservationsPerBucket": 0,
    "detectionMethod": "BaselinePercent",
    "methodParamsJson": "{\"lookbackDays\":7,\"thresholdPercent\":50}",
    "consecutiveCount": 2,
    "cooldownMinutes": 30,
    "enabled": true,
    "profileKey": "kinectify",
    "grain": "domain",
    "maxEntitiesPerBucket": 100,
    "kqlText": "let counts = app('{{SOURCE:aml-screening-api}}').customEvents\n| where timestamp >= {{from}} and timestamp < {{to}}\n| where name == \"TransactionScreened\"\n| summarize TotalCount = count() by BucketStart = bin_at(timestamp, {{bucket}}, datetime(1970-01-01));\nrange BucketStart from bin_at({{from}}, {{bucket}}, datetime(1970-01-01)) to {{to}} - 1tick step {{bucket}}\n| join kind=leftouter counts on BucketStart\n| project ['kind'] = \"bucket\", BucketStart, TotalCount = tolong(coalesce(TotalCount, 0)), Value = todouble(coalesce(TotalCount, 0))",
    "kqlDescription": "Transactions that completed risk screening per 5-minute bucket (Kinectify demo). A drop means customer transactions are not being screened. Zero-filled: a bucket without events reads 0."
  },
