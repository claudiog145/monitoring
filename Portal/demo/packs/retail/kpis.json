  {
    "kpiDefinitionId": 0,
    "pillar": "Business",
    "kpi": "Orders placed",
    "domain": "checkout",
    "stage": "",
    "sourceKey": "kql:kpi:retail-orders-placed",
    "direction": "Decrease",
    "aggregation": "Count",
    "evaluationFrequency": "00:01:00",
    "bucketSize": "00:05:00",
    "lookbackWindow": "1.00:00:00",
    "sampleSize": 0,
    "minObservationsPerBucket": 0,
    "detectionMethod": "BaselinePercent",
    "methodParamsJson": "{\"lookbackDays\":7,\"thresholdPercent\":40}",
    "consecutiveCount": 3,
    "cooldownMinutes": 30,
    "enabled": true,
    "profileKey": "mercadolibre",
    "grain": "domain",
    "maxEntitiesPerBucket": 10,
    "kqlText": "let events = app('{{SOURCE:retail-checkout-api}}').customEvents\n| where timestamp >= {{from}} and timestamp < {{to}}\n| where name == \"OrderPlaced\"\n| summarize TotalCount = count(), Value = count() by BucketStart = bin_at(timestamp, {{bucket}}, datetime(1970-01-01));\nrange BucketStart from bin_at({{from}}, {{bucket}}, datetime(1970-01-01)) to {{to}} - 1tick step {{bucket}}\n| join kind=leftouter events on BucketStart\n| project ['kind'] = \"bucket\", BucketStart, TotalCount = tolong(coalesce(TotalCount, 0)), Value = coalesce(todouble(Value), 0.0)",
    "kqlDescription": "OrderPlaced events per 5-minute bucket - Mercado Libre (demo)."
  },
