    "kqlText": "let events = app('{{SOURCE:retail-checkout-api}}').customEvents\n| where timestamp >= {{from}} and timestamp < {{to}}\n| where name == \"OrderPlaced\"\n| summarize TotalCount = count(), Value = sum(todouble(customMeasurements.AmountUsd)) by BucketStart = bin_at(timestamp, {{bucket}}, datetime(1970-01-01));\nrange BucketStart from bin_at({{from}}, {{bucket}}, datetime(1970-01-01)) to {{to}} - 1tick step {{bucket}}\n| join kind=leftouter events on BucketStart\n| project ['kind'] = \"bucket\", BucketStart, TotalCount = tolong(coalesce(TotalCount, 0)), Value = coalesce(todouble(Value), 0.0)",
    "kqlDescription": "Gross merchandise value: sum of OrderPlaced AmountUsd per 5-minute bucket - Mercado Libre (demo)."
