      "defaultDurationMinutes": 40,
      "effects": [
        { "kind": "dependency-failure", "partner": "carrier-b", "rate": 0.75 },
        { "kind": "latency-multiplier", "partner": "carrier-b", "factor": 8 },
        { "kind": "error-rate", "step": "POST /api/shipping/quote", "rate": 0.05, "exceptionType": "System.TimeoutException" }
      ]
    },
    {
      "key": "orders-drop",
      "title": "Silent drop in orders and GMV",
      "description": "A storefront feature flag hides the buy box for part of the catalog: add-to-cart, orders, payments and labels fall by 60-70 % with no errors and normal latency. Only the business KPIs notice.",
      "defaultDurationMinutes": 45,
      "effects": [
        { "kind": "traffic-multiplier", "step": "POST /cart/items", "factor": 0.4 },
        { "kind": "traffic-multiplier", "step": "POST /api/checkout/orders", "factor": 0.3 },
        { "kind": "traffic-multiplier", "step": "POST /api/payments", "factor": 0.3 },
        { "kind": "traffic-multiplier", "step": "POST /api/shipping/labels", "factor": 0.3 }
      ]
    },
    {
      "key": "hot-sale",
      "title": "Hot Sale (legitimate traffic peak)",
