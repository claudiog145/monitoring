        { "kind": "error-rate", "step": "POST /api/checkout/quote", "rate": 0.12, "exceptionType": "System.InvalidOperationException" },
        { "kind": "latency-multiplier", "step": "POST /api/checkout/quote", "factor": 2.5 }
