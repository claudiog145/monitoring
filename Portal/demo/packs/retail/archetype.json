  "scenarios": [
    {
      "key": "search-latency-mlm",
      "title": "Search latency in Mexico (MLM)",
      "description": "A search-cluster shard serving the MLM index is rebalancing: search on site MLM gets 6-7x slower and a few queries time out. The other sites are healthy.",
      "defaultDurationMinutes": 30,
      "effects": [
        { "kind": "entity-only", "entities": ["MLM"] },
        { "kind": "latency-multiplier", "partner": "search-cluster", "factor": 7 },
        { "kind": "latency-multiplier", "step": "GET /search", "factor": 3.5 },
        { "kind": "error-rate", "step": "GET /api/search", "rate": 0.04, "exceptionType": "System.TimeoutException" }
      ]
    },
    {
      "key": "payment-gateway-outage",
