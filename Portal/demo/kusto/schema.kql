// Application Insights schema for one demo application database (contract v5 §4.1).
// One management command per non-comment line; .create-merge makes every line idempotent, so the
// generator can apply the whole file to a new or an existing database. Column names and types are
// the App Insights ones: queries written for the real service run unchanged.

.create-merge table requests (timestamp:datetime, id:string, name:string, url:string, resultCode:string, duration:real, success:bool, performanceBucket:string, itemType:string, customDimensions:dynamic, customMeasurements:dynamic, operation_Name:string, operation_Id:string, operation_ParentId:string, session_Id:string, user_Id:string, user_AuthenticatedId:string, client_Type:string, client_Model:string, client_OS:string, client_IP:string, client_City:string, client_StateOrProvince:string, client_CountryOrRegion:string, client_Browser:string, cloud_RoleName:string, cloud_RoleInstance:string, appId:string, appName:string, iKey:string, sdkVersion:string, itemId:string, itemCount:int, source:string)
.create-merge table exceptions (timestamp:datetime, problemId:string, handledAt:string, type:string, message:string, assembly:string, method:string, outerType:string, outerMessage:string, outerAssembly:string, outerMethod:string, innermostType:string, innermostMessage:string, innermostAssembly:string, innermostMethod:string, severityLevel:int, details:dynamic, customDimensions:dynamic, customMeasurements:dynamic, operation_Name:string, operation_Id:string, operation_ParentId:string, session_Id:string, user_Id:string, client_Type:string, client_Model:string, client_OS:string, client_IP:string, client_City:string, client_StateOrProvince:string, client_CountryOrRegion:string, client_Browser:string, cloud_RoleName:string, cloud_RoleInstance:string, appId:string, appName:string, itemId:string, itemCount:int)
.create-merge table dependencies (timestamp:datetime, id:string, target:string, type:string, name:string, data:string, success:bool, resultCode:string, duration:real, performanceBucket:string, customDimensions:dynamic, customMeasurements:dynamic, operation_Name:string, operation_Id:string, operation_ParentId:string, session_Id:string, user_Id:string, client_Type:string, client_Model:string, client_OS:string, client_IP:string, client_City:string, client_StateOrProvince:string, client_CountryOrRegion:string, client_Browser:string, cloud_RoleName:string, cloud_RoleInstance:string, appId:string, appName:string, itemId:string, itemCount:int)
.create-merge table traces (timestamp:datetime, message:string, severityLevel:int, customDimensions:dynamic, customMeasurements:dynamic, operation_Name:string, operation_Id:string, operation_ParentId:string, session_Id:string, user_Id:string, client_Type:string, client_Model:string, client_OS:string, client_IP:string, client_City:string, client_StateOrProvince:string, client_CountryOrRegion:string, client_Browser:string, cloud_RoleName:string, cloud_RoleInstance:string, appId:string, appName:string, itemId:string, itemCount:int)
.create-merge table pageViews (timestamp:datetime, id:string, name:string, url:string, duration:real, performanceBucket:string, customDimensions:dynamic, customMeasurements:dynamic, operation_Name:string, operation_Id:string, session_Id:string, user_Id:string, client_Type:string, client_Model:string, client_OS:string, client_IP:string, client_City:string, client_StateOrProvince:string, client_CountryOrRegion:string, client_Browser:string, cloud_RoleName:string, appId:string, appName:string, itemId:string, itemCount:int)
.create-merge table customEvents (timestamp:datetime, name:string, customDimensions:dynamic, customMeasurements:dynamic, operation_Name:string, operation_Id:string, session_Id:string, user_Id:string, client_Type:string, client_Model:string, client_OS:string, client_IP:string, client_City:string, client_StateOrProvince:string, client_CountryOrRegion:string, client_Browser:string, cloud_RoleName:string, appId:string, appName:string, itemId:string, itemCount:int)
