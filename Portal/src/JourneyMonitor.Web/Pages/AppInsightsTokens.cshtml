<!-- AppInsights Token Management UI -->
<!-- Add this to: Portal/src/JourneyMonitor.Web/Pages/Settings.cshtml or create a new page -->

<div class="appinsights-settings-container">
    <h2>AppInsights Access Tokens</h2>
    <p class="description">
        Manage Azure AppInsights tokens for each tenant. Each user generates their own token 
        using Azure CLI and pastes it here.
    </p>

    <!-- Instructions Section -->
    <div class="instructions-card">
        <h3>How to Generate a Token</h3>
        <ol>
            <li>Open Terminal or PowerShell</li>
            <li>Login to your Azure account:
                <code>az login --tenant YOUR-TENANT-ID</code>
            </li>
            <li>Get access token:
                <code>az account get-access-token --scope https://api.applicationinsights.io/.default</code>
            </li>
            <li>Copy the entire <strong>accessToken</strong> value (the long JWT string)</li>
            <li>Paste it below in the form</li>
        </ol>
        <div class="example">
            <strong>Example command output:</strong>
            <pre>{
  "accessToken": "eyJ0eXAiOiJKV1QiLCJhbGc...(very long string)...kDw",
  "expires_on": 1730280000,
  "expiresOn": "2024-10-30 08:00:00.000000",
  "subscription": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx",
  "tenant": "yyyyyyyy-yyyy-yyyy-yyyy-yyyyyyyyyyyy",
  "tokenType": "Bearer"
}</pre>
        </div>
    </div>

    <!-- Add Token Form -->
    <div class="form-card">
        <h3>Add New Token</h3>
        <form id="addTokenForm">
            <div class="form-group">
                <label for="tenantKey">Tenant *</label>
                <select id="tenantKey" name="tenantKey" required>
                    <option value="">-- Select Tenant --</option>
                    <option value="arrivia">Arrivia</option>
                    <option value="ice">Ice Enterprise</option>
                    <option value="acme">Acme Corp</option>
                </select>
                <small>Select which company this token is for</small>
            </div>

            <div class="form-group">
                <label for="email">Email Address *</label>
                <input 
                    type="email" 
                    id="email" 
                    name="email" 
                    placeholder="cgareca@arrivia.com" 
                    required />
                <small>Your Azure account email (for audit trail)</small>
            </div>

            <div class="form-group">
                <label for="token">Azure Access Token *</label>
                <textarea 
                    id="token" 
                    name="token" 
                    placeholder="eyJ0eXAiOiJKV1QiLCJhbGc..." 
                    rows="6"
                    required></textarea>
                <small>Paste the entire 'accessToken' value from 'az account get-access-token' output</small>
            </div>

            <div class="form-group">
                <label for="notes">Notes (optional)</label>
                <input 
                    type="text" 
                    id="notes" 
                    name="notes" 
                    placeholder="e.g., 'Generated on 2024-10-30 by Claudio'" />
                <small>Optional notes for reference</small>
            </div>

            <button type="submit" class="btn btn-primary">Save Token</button>
            <button type="button" class="btn btn-secondary" onclick="clearTokenForm()">Clear</button>
        </form>
        <div id="addTokenStatus" style="margin-top: 15px;"></div>
    </div>

    <!-- Stored Tokens List -->
    <div class="tokens-list-card">
        <h3>Stored Tokens</h3>
        <button type="button" class="btn btn-info" onclick="refreshTokensList()">Refresh</button>
        <div id="tokensList" class="loading">Loading tokens...</div>
    </div>

    <!-- Sample Queries -->
    <div class="samples-card">
        <h3>Sample KQL Queries</h3>
        <div id="samplesList" class="samples-grid"></div>
    </div>
</div>

<style>
