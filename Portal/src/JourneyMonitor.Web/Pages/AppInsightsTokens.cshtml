    color: #333;
    margin-bottom: 10px;
    border-bottom: 2px solid #007bff;
    padding-bottom: 10px;
}

.appinsights-settings-container .description {
    color: #666;
    margin-bottom: 30px;
    font-size: 14px;
}

.instructions-card,
.form-card,
.tokens-list-card,
.samples-card {
    border: 1px solid #ddd;
    border-radius: 8px;
