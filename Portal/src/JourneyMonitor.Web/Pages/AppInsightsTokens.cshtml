<script>
// Add Token Form Handler
document.getElementById('addTokenForm').addEventListener('submit', async (e) => {
    e.preventDefault();

    const tenantKey = document.getElementById('tenantKey').value;
    const email = document.getElementById('email').value;
    const token = document.getElementById('token').value;
    const notes = document.getElementById('notes').value;
    const statusDiv = document.getElementById('addTokenStatus');

    // Clear previous status
    statusDiv.innerHTML = '';

    // Validate token format (basic JWT check)
    if (!token.includes('.') || token.split('.').length !== 3) {
        showStatus(statusDiv, 'error', 'Invalid token format. Must be a JWT with 3 parts (header.payload.signature)');
        return;
    }

    try {
        showStatus(statusDiv, 'info', 'Validating and saving token...');

        const response = await fetch('/api/appinsights/tokens', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                tenantKey,
                email,
                token,
                notes
            })
        });

        const data = await response.json();

        if (response.ok) {
            showStatus(statusDiv, 'success', data.message || 'Token saved successfully!');
            document.getElementById('addTokenForm').reset();
            setTimeout(() => {
                refreshTokensList();
            }, 1000);
        } else {
            showStatus(statusDiv, 'error', data.error || 'Failed to save token');
            if (data.hint) {
                statusDiv.innerHTML += `<br><small>${data.hint}</small>`;
            }
        }
    } catch (error) {
        console.error('Error:', error);
        showStatus(statusDiv, 'error', `Error: ${error.message}`);
    }
});

function clearTokenForm() {
    document.getElementById('addTokenForm').reset();
    document.getElementById('addTokenStatus').innerHTML = '';
}

async function refreshTokensList() {
    const tokensList = document.getElementById('tokensList');
    tokensList.innerHTML = '<div class="loading"><div class="spinner"></div> Loading tokens...</div>';

    try {
        const response = await fetch('/api/appinsights/tokens');
        const data = await response.json();

        if (!data.success || data.count === 0) {
            tokensList.innerHTML = '<div class="empty-state"><p>No tokens configured yet.</p><p>Add a token above to get started.</p></div>';
            return;
        }

        let html = '<table class="tokens-table"><thead><tr>' +
            '<th>Tenant</th>' +
            '<th>Email</th>' +
            '<th>Status</th>' +
            '<th>Added</th>' +
            '<th>Expires</th>' +
            '<th>Usage</th>' +
            '<th>Actions</th>' +
            '</tr></thead><tbody>';

        for (const token of data.tokens) {
            const statusClass = token.isValid ? 'valid' : (token.isExpired ? 'expired' : 'inactive');
            const statusText = token.isValid ? 'Valid' : (token.isExpired ? 'Expired' : 'Inactive');

            html += `<tr>
                <td><strong>${token.tenantKey}</strong></td>
                <td>${token.email}</td>
                <td><span class="token-status ${statusClass}">${statusText}</span></td>
                <td>${new Date(token.createdAt).toLocaleDateString()}</td>
                <td>${new Date(token.expiresAt).toLocaleString()}</td>
                <td>${token.usageCount} times</td>
                <td>
                    <button type="button" class="btn btn-danger" onclick="deactivateToken('${token.tenantKey}')">Deactivate</button>
                </td>
            </tr>`;
        }

        html += '</tbody></table>';
        tokensList.innerHTML = html;
    } catch (error) {
        console.error('Error:', error);
        tokensList.innerHTML = `<div class="status-message error">Error loading tokens: ${error.message}</div>`;
    }
}

async function deactivateToken(tenantKey) {
    if (!confirm(`Deactivate token for ${tenantKey}? You can add a new one anytime.`)) {
        return;
    }

    try {
        const response = await fetch(`/api/appinsights/tokens/${tenantKey}/deactivate`, {
            method: 'POST'
        });

        const data = await response.json();

        if (response.ok) {
            showStatus(document.getElementById('tokensList'), 'success', data.message);
            setTimeout(() => refreshTokensList(), 1000);
        } else {
            showStatus(document.getElementById('tokensList'), 'error', data.error);
        }
    } catch (error) {
        console.error('Error:', error);
        showStatus(document.getElementById('tokensList'), 'error', `Error: ${error.message}`);
    }
}

async function loadSampleQueries() {
    try {
        const response = await fetch('/api/appinsights/samples');
        const data = await response.json();

        const samplesList = document.getElementById('samplesList');
        let html = '';

        for (const sample of data.samples) {
            html += `<div class="sample-card" title="Click to copy">
                <strong>${sample.name}</strong>
                <code>${sample.query}</code>
            </div>`;
        }

        samplesList.innerHTML = html;
    } catch (error) {
        console.error('Error loading samples:', error);
    }
}

function showStatus(container, type, message) {
    container.innerHTML = `<div class="status-message ${type}">${message}</div>`;
}

// Load tokens and samples on page load
window.addEventListener('load', () => {
    refreshTokensList();
    loadSampleQueries();
});
</script>
