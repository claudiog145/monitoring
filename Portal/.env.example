# Optional. Copy to .env (gitignored).
#
# SQL Server in docker compose (must meet SQL complexity rules). Host tools can use
# Server=localhost,1433;Database=platformDB;User Id=sa;Password=...;TrustServerCertificate=True;
# MSSQL_SA_PASSWORD=Jm_LocalDev_1!
#
# Service principal instead of `docker compose exec functions az login --use-device-code`.
# The principal needs Monitoring Reader on the Application Insights resources you query.
# AZURE_TENANT_ID=60396ff5-e90f-4bc5-aced-a4f462f2636e
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# Optional. GitHub OAuth token (gho_, NOT a ghp_ PAT) for the Doctor Monkey's LLM calls via the
# GitHub Copilot API. Generate with: gh auth login --scopes copilot && gh auth token.
# Only a fallback now - the Settings tab's "LLM Client" section (PUT /api/settings/llm-client)
# stores this in SQL and is preferred for anything past local dev, since it does not need an
# environment-specific value configured by hand (docker-compose, QA Container App, ...). This
# env var is used only when nothing has ever been saved there yet - see LlmClientSettingsResolver.
# Ai__GitHubToken=

# Optional. Microsoft Foundry, the other LLM provider. Same precedence rule as Ai__GitHubToken:
# these are only a fallback, the Settings tab's "LLM Client" section is preferred because it
# needs nothing configured per environment. Which provider each agent uses is chosen there too
# (globally, or per agent for a gradual migration).
#
# Endpoint accepts either form the portal shows; the /openai/v1 route is appended automatically:
# Foundry__Endpoint=https://<resource>.openai.azure.com
#
# AuthMode is 'api-key' or 'managed-identity'. Prefer managed-identity: it stores no secret at
# all, so it is not exposed to the Data Protection key ring, and the identity needs an inference
# role on the Foundry resource (token scope https://ai.azure.com/.default).
# Foundry__AuthMode=managed-identity
# Foundry__ApiKey=
#
# IMPORTANT: these are DEPLOYMENT names, not model ids. A model id from GitHub Copilot sent to
# Foundry resolves to nothing. The same applies to Inspector__DebateModels and
# Inspector__PlannerModel while the Inspector is on Foundry.
# Foundry__ChatDeployment=
# Foundry__EmbeddingDeployment=

# Optional. RCA Agent. Defaults: Enabled=true, AutoComposeOnEscalation=true, MaxPrecedents=5,
# MaxTokens=4000. With auto-compose on, an investigation that closes ESCALATED and names a
# probable root cause writes its own RCA - one extra provider call per qualifying case, on top of
# the Inspector's ~25. Set AutoComposeOnEscalation=false to leave the case-file button as the only
# way in; Enabled=false turns off both routes.
# Do not lower MaxTokens below ~3000 - the template is eight sections plus a five-rung Whys
# chain, and a truncated RCA is unparseable.
# Rca__Enabled=
# Rca__AutoComposeOnEscalation=
# Rca__MaxPrecedents=
# Rca__MaxTokens=

# Optional. What the Inspector is allowed to spend. Measured over 32 real investigations:
# the MOA debate is 64% of all tokens this system burns, and the rounds AFTER the independent
# round 0 are 43% of the total on their own. These are the three dials that matter.
#
#   DebateRounds (default 2)  rounds after round 0, where each model reads its peers. Set to 0
#                             to keep only the independent readings - round 0 always runs, so
#                             the synthesis still gets one opinion per model.
#   DebateModels              the roster. Fewer models is a linear saving across every round.
#   SkipDebateWhenContributorsBelow (default 0 = never skip)
#                             drops the peer rounds when fewer than N specialists actually
#                             contributed evidence. Asking three models to reconcile an empty
#                             blackboard costs nine completions to conclude "insufficient
#                             evidence", which the verdict reaches anyway.
#
# MaxInvestigationsPerDay (default 40) is the only hard spend ceiling: an unpaused Inspector
# burned 1.6M input tokens in 35 minutes and hit the provider rate limit.
# Inspector__DebateRounds=
# Inspector__DebateModels=
# Inspector__SkipDebateWhenContributorsBelow=
# Inspector__MaxInvestigationsPerDay=
# Inspector__MaxHelpHops=
# Inspector__MaxToolRounds=

# Optional. Directory of converted Markdown that the knowledge base imports from. Defaults to
# /corpus, which docker-compose mounts read-only from docs/RCAS-md.
#
# A DEPLOYED environment (QA, production) has no such mount: docs/ is git-ignored and nothing
# copies it into the image, so POST /api/knowledge/import answers 409 naming the path it looked
# at. Nothing breaks - the knowledge base simply stays empty and the RCA Agent composes with no
# precedents, which the Memory Bank tab reports as such. Point this at a mounted volume to change
# that, and note the corpus contains real customer-incident text.
# KnowledgeImport__CorpusPath=
# KnowledgeImport__MaxDocumentsPerRun=

# Optional demo override. Production defaults (5000ms / 5 occurrences / 60min window, see
# MonitoringOptions) rarely fire within a short local demo session. Uncomment to see real
# Latency Spike Monkey findings from real production data within one 5-min timer tick.
# Monitoring__SpikeThresholdMs=100
# Monitoring__SpikeOccurrenceThreshold=1
# Monitoring__SpikeWindowMinutes=60

# Optional. CSV of domains that use the SQL-journey-store-based Latency Spike Monkey detector
# instead of the KQL one (gradual rollout - see
# docs/product/latency-spike-doctor-monkey-db-migration-plan-2026-09-21.md). Requires
# JourneySync__Domains to include the same domain(s) so SyncJourneys has actually populated them.
# Monitoring__SqlDetectorDomains=cars

# Optional. CSV of domains where, alongside the active detector above, the OTHER detector also
# runs a side-by-side dry run and logs a comparison (Fase 3 validation) - no second Finding is
# created. Uncomment while validating the SQL detector against the KQL one for the same domain.
# Monitoring__ShadowDomains=cars

# --- Detection agents: latency scout and exception scout ----------------------------------
# Two agents, one per priority board, same pipeline. Every setting below exists twice -
# ScoutLatency__* and ScoutException__* - so each one has its own window, cap and minimum rank.
# All optional; unset = the documented defaults. Each reads PRODUCTION Application Insights every
# 5 minutes (one cross-resource query, ~45s), so set <Scout>__Enabled=false to silence one of them
# without rebuilding - the cycle is still recorded with status "disabled", so a silenced scout
# stays visible instead of looking dead.
# ScoutLatency__Enabled=false
# ScoutException__Enabled=false
#
# How far back the board query looks. 4 matches the Azure workbook "SRE Reliability Priorities";
# 0.25 (15 min) is the cheaper alternative.
# ScoutLatency__WindowHours=4
# ScoutException__WindowHours=4
#
# Rows kept per club per board. The workbook keeps 10 per VERTICAL globally, which lets the
# highest-volume club crowd everyone else out - measured on real data that hid 112 clubs with
# rank>=2 problems. 3 is the measured sweet spot.
# ScoutLatency__TakePerClub=3
# ScoutException__TakePerClub=3
#
# Board rank that produces an InvestigationPackage. KEEP THIS AT 3 IN EVERY ENVIRONMENT,
# PRODUCTION INCLUDED: rank 2 is ~350 candidates per cycle and must not be switched on until the
# real per-investigation cost has been measured (agreed 2026-10-07).
# ScoutLatency__InvestigationMinPriorityRank=3
# ScoutException__InvestigationMinPriorityRank=3
#
# Hard cap on packages created per cycle, PER SCOUT - protects the first cycle, where nothing is
# deduped yet. The two no longer share one budget.
# ScoutLatency__MaxNewCasesPerRun=25
# ScoutException__MaxNewCasesPerRun=25
#
# Whether the scout asks the LLM to read each candidate. When false (or when no LLM is
# configured) packages still ship with the board's deterministic evidence and an explicitly
# unavailable assessment.
# ScoutLatency__UseLlmAssessment=true
# ScoutException__UseLlmAssessment=true
#
# Whether a scout veto can stop a handoff. Off by design: its opinion is recorded on every
# package, but the board's deterministic rank decides until the assessment has been evaluated
# against real cases.
# ScoutLatency__AllowScoutVeto=false
# ScoutException__AllowScoutVeto=false

# Shared secret required (via the X-Settings-Write-Secret header) on
# PUT /api/settings/latency/{domain} and PUT /api/settings/llm-client - see
# UpsertLatencySpikeSettingFunction/UpsertLlmClientSettingFunction. Fails CLOSED, not
# open: docker-compose.yml already sets a local-only default (Jm_LocalDev_SettingsSecret_1!) for
# both variables so `docker compose up` works out of the box - override BOTH here to the SAME
# value for a real deployment (one per service, different config prefixes).
# Monitoring__SettingsWriteSecret=change-me
# JourneyMonitorApi__SettingsWriteSecret=change-me

# Same fail-closed pairing as above, for GET /api/findings/{id}/doctor-report and
# POST /api/settings/llm-client/models (see MonitoringOptions.InternalApiSecret) - these are not
# Settings writes but still expose more than a plain read once Entra is configured, so they get
# their own secret rather than reusing the write one.
# Monitoring__InternalApiSecret=change-me
# JourneyMonitorApi__InternalApiSecret=change-me

# Which company the agents classify for when nothing else names one. docker-compose.yml defaults
# it to the seeded incumbent ("arrivia"); set it here to onboard a different company as the
# platform's baseline. Blank is a HARD FAILURE on purpose - a Scout cycle that classified nothing
# would be indistinguishable from a healthy one.
#
# This is only the fallback. The live pointer is monitoring.ActiveCompanyProfile, flipped from the
# portal's company selector (PUT /api/settings/company-profiles-active), and it WINS over this
# value - which is what lets an operator switch company without a redeploy.
# Company__DefaultProfileKey=arrivia

